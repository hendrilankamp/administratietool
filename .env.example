# ============================================================
# OPTIONEEL – alleen nodig voor lokaal ontwikkelen of speciale situaties.
# Op de Synology heb je dit bestand NIET nodig: koppelingen stel je in via
# Instellingen in de app, en de geheime sleutel wordt automatisch aangemaakt.
# ============================================================

# Lokaal ontwikkelen
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data

# Geheime sleutel. Leeg = automatisch aangemaakt in DATA_DIR/app-secret.
# Zet hem hier alleen als je hem zelf wilt beheren (min. 32 tekens: openssl rand -base64 48).
# APP_SECRET=

# Map voor versleutelde externe backups (in de container: /backup-extern)
# BACKUP_EXTERN_DIR=./extern

# Achter een reverse proxy met HTTPS (bv. DSM): vertrouw X-Forwarded-*-headers van het lokale netwerk
# TRUST_PROXY=uniquelocal

# Koppelingen kunnen ook hier (de waarden in Instellingen gaan voor):
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# MOLLIE_TOKEN=
# MOLLIE_TESTMODE=false
# MS_CLIENT_ID=
# MS_TENANT_ID=
# AGE_PASSPHRASE=
# AGE_RECIPIENT=
# BACKUP_UUR=3
