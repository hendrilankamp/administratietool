<%- include('../partials/kop') %>
<h1>Verkoopfacturen</h1>
<div class="acties">
  <% if (mollie) { %>
    <form method="post" action="/verkoop/mollie-sync" class="inline"><%- include('../partials/csrf') %><button class="primair" type="submit">Nu synchroniseren met Mollie</button></form>
  <% } else { %>
    <span class="hulp">Mollie is niet gekoppeld. <a href="/instellingen#mollie">Instellen</a></span>
  <% } %>
  <form method="post" action="/verkoop/nieuw" class="inline"><%- include('../partials/csrf') %><button type="submit">Handmatige verkoopfactuur vastleggen</button></form>
</div>
<form method="get" class="rij">
  <div><label>Zoeken</label><input name="zoek" value="<%= query.zoek || '' %>" placeholder="Klant, factuurnummer…"></div>
  <div class="smal"><label>Betaling</label><select name="betaal"><option value="">Alle</option><option value="onbetaald" <%= query.betaal === 'onbetaald' ? 'selected' : '' %>>Nog te ontvangen</option><option value="betaald" <%= query.betaal === 'betaald' ? 'selected' : '' %>>Betaald</option></select></div>
  <% if (aantalGeannuleerd) { %><div class="smal"><label><input type="checkbox" name="geannuleerd" value="1" <%= query.geannuleerd === '1' ? 'checked' : '' %>> Toon geannuleerde (<%= aantalGeannuleerd %>)</label></div><% } %>
  <div class="smal"><button type="submit">Filter</button></div>
</form>
<form method="post" action="/rapportages/markeer-betaald" data-bevestig="Geselecteerde facturen markeren als ontvangen (op de vervaldatum, of anders de factuurdatum)?">
<%- include('../partials/csrf') %><input type="hidden" name="soort" value="verkoop"><input type="hidden" name="terug" value="/verkoop<%= query.betaal ? '?betaal=' + query.betaal : '' %>">
<% if (facturen.some(f => f.status === 'geboekt' && f.betaalstatus !== 'betaald')) { %>
  <div class="acties mt1"><button class="klein" type="submit">Geselecteerde markeren als ontvangen</button><span class="hulp">Voor contante betalingen of ontvangsten van vóór de eerste bankimport.</span></div>
<% } %>
<div class="tabel-wrap mt1">
<table class="klikbaar">
  <thead><tr><th><input type="checkbox" data-alles-selecteren title="Alles selecteren"></th><th>Datum</th><th>Factuurnr.</th><th>Klant</th><th>Bron</th><th class="bedrag">Excl.</th><th class="bedrag">Totaal</th><th class="bedrag">Open</th><th>Status</th></tr></thead>
  <tbody>
  <% if (!facturen.length) { %><tr><td colspan="9" class="zacht">Geen facturen.</td></tr><% } %>
  <% facturen.forEach(f => { %>
    <tr data-href="/verkoop/<%= f.id %>">
      <td><% if (f.status === 'geboekt' && f.betaalstatus !== 'betaald') { %><input type="checkbox" name="ids[]" value="<%= f.id %>"><% } %></td>
      <td class="nowrap"><%= nlDatum(f.factuurdatum) %></td>
      <td><a href="/verkoop/<%= f.id %>"><%= f.factuurnummer || ('#' + f.id) %></a></td>
      <td><%= f.relatie_naam || '—' %></td>
      <td><%= f.bron === 'mollie' ? 'Mollie' : 'handmatig' %><%= f.is_creditnota ? ' · creditnota' : '' %><% if (f.mollie_status) { %> <span class="hulp">(<%= f.mollie_status %>)</span><% } %></td>
      <td class="bedrag"><%= euro(f.totaal_excl) %></td>
      <td class="bedrag"><%= euro(f.totaal_incl) %></td>
      <td class="bedrag"><%= f.status === 'geboekt' && f.betaalstatus !== 'betaald' ? euro(f.openstaand) : '' %></td>
      <td><%- include('../partials/betaalstatus', { f }) %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
</form>
<%- include('../partials/voet') %>
