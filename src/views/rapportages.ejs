<%- include('partials/kop') %>
<h1>Rapportages</h1>
<form method="get" class="rij">
  <div class="smal"><label>Jaar</label><input type="number" name="jaar" value="<%= jaar %>" min="2000" max="2100"></div>
  <div class="smal"><label>Periode</label><select name="kwartaal"><option value="">Heel jaar</option><% [1,2,3,4].forEach(k => { %><option value="<%= k %>" <%= kw === k ? 'selected' : '' %>>Q<%= k %></option><% }) %></select></div>
  <div class="smal"><button type="submit">Toon</button></div>
  <div class="smal"><a class="knop" href="/rapportages/export/<%= jaar %>">Export voor accountant <%= jaar %> (zip)</a></div>
</form>

<h2>Winst &amp; verlies <%= kw ? 'Q' + kw + ' ' : '' %><%= jaar %> <span class="hulp">(exclusief BTW)</span></h2>
<div class="kolommen">
  <div class="tabel-wrap"><table>
    <thead><tr><th>Omzet</th><th class="bedrag">Bedrag</th></tr></thead>
    <tbody><% wv.omzet.forEach(r => { %><tr><td><%= r.categorie %></td><td class="bedrag"><%= euro(r.bedrag) %></td></tr><% }) %></tbody>
    <tfoot><tr><td>Totaal omzet</td><td class="bedrag"><%= euro(wv.totaalOmzet) %></td></tr></tfoot>
  </table></div>
  <div class="tabel-wrap"><table>
    <thead><tr><th>Kosten</th><th class="bedrag">Bedrag</th></tr></thead>
    <tbody><% wv.kosten.forEach(r => { %><tr><td><%= r.categorie %></td><td class="bedrag"><%= euro(r.bedrag) %></td></tr><% }) %></tbody>
    <tfoot><tr><td>Totaal kosten</td><td class="bedrag"><%= euro(wv.totaalKosten) %></td></tr></tfoot>
  </table></div>
</div>
<div class="paneel"><strong>Resultaat: <span class="<%= wv.resultaat < 0 ? 'negatief' : '' %>"><%= euro(wv.resultaat) %></span></strong>
  <p class="hulp mb0">Investeringen boven € 450 moeten fiscaal worden afgeschreven; die staan hier als kosten. Bespreek ze met je accountant. Bedragen bij “neutraal” (privé, belastingen, eigen overboekingen) tellen niet mee.</p>
</div>
<% if (wv.neutraal.length) { %><p class="hulp">Neutraal: <%= wv.neutraal.map(r => r.categorie + ' ' + euro(r.bedrag)).join(' · ') %></p><% } %>

<h2 id="doorbelasting">Doorbelasting per klant <span class="hulp">(ingekocht voor de klant tegenover gefactureerd, excl. BTW)</span></h2>
<% if (doorbelasting.nietToegewezen.length) { %>
  <div class="melding let">Inkoopregels met een klantnaam die nog niet aan een klant gekoppeld is:
    <ul><% doorbelasting.nietToegewezen.forEach(n => { %><li><strong><%= n.naam %></strong> – <%= n.aantal %> regel(s), <%= euro(n.bedrag) %> · <a href="/relaties/nieuw?type=klant">klant aanmaken</a></li><% }) %></ul>
    <span class="hulp">Na het aanmaken worden de regels automatisch gekoppeld (herkend op naam of e-maildomein), of kies de klant per regel op de inkoopfactuur.</span></div>
<% } %>
<% if (!doorbelasting.klanten.length) { %>
  <p class="hulp">Nog geen doorbelaste inkoop in deze periode. Kies op een inkoopfactuur per regel “Doorbelasten aan”.</p>
<% } else { %>
<div class="tabel-wrap"><table>
  <thead><tr><th>Klant</th><th class="bedrag">Ingekocht</th><th class="bedrag">Gefactureerd</th><th class="bedrag">Verschil</th><th>Details</th></tr></thead>
  <tbody>
  <% doorbelasting.klanten.forEach(k => { %>
    <tr>
      <td><a href="/relaties/<%= k.relatie_id %>"><%= k.naam %></a><% if (!k.verkoopfacturen.length) { %> <span class="label-status fout">geen verkoopfactuur</span><% } %></td>
      <td class="bedrag"><%= euro(k.ingekocht) %></td>
      <td class="bedrag"><%= euro(k.verkocht) %></td>
      <td class="bedrag <%= k.verschil < 0 ? 'negatief' : '' %>"><%= euro(k.verschil) %></td>
      <td><details><summary class="klein"><%= k.regels.length %> inkoopregel(s), <%= k.verkoopfacturen.length %> verkoopfactuur/-facturen</summary>
        <ul class="klein">
          <% k.regels.forEach(r => { %><li>Inkoop <a href="/inkoop/<%= r.factuur_id %>"><%= r.factuurnummer || '#' + r.factuur_id %></a> <%= r.leverancier ? '(' + r.leverancier + ')' : '' %> <%= nlDatum(r.factuurdatum) %>: <%= r.omschrijving || '' %><%= r.periode ? ' · ' + r.periode : '' %> – <%= euro(r.bedrag_excl) %></li><% }) %>
          <% k.verkoopfacturen.forEach(v => { %><li>Verkoop <a href="/verkoop/<%= v.id %>"><%= v.factuurnummer || '#' + v.id %></a> <%= nlDatum(v.factuurdatum) %> – <%= euro(v.totaal_excl) %></li><% }) %>
        </ul></details></td>
    </tr>
  <% }) %>
  </tbody>
  <tfoot><tr><td>Totaal</td><td class="bedrag"><%= euro(doorbelasting.klanten.reduce((s, k) => s + k.ingekocht, 0)) %></td><td class="bedrag"><%= euro(doorbelasting.klanten.reduce((s, k) => s + k.verkocht, 0)) %></td><td class="bedrag"><%= euro(doorbelasting.klanten.reduce((s, k) => s + k.verschil, 0)) %></td><td></td></tr></tfoot>
</table></div>
<p class="hulp">“Gefactureerd” is het totaal van alle verkoopfacturen aan deze klant in de periode (ook voor andere diensten). Een negatief verschil betekent dat je meer inkoopt dan je doorbelast. Kies “Heel jaar” om jaarlijkse facturen tegenover maandelijkse inkoop te zien.</p>
<% } %>

<% const periodeTekst = kw ? 'Q' + kw + ' ' + jaar : String(jaar); %>
<% const terugUrl = '/rapportages?jaar=' + jaar + (kw ? '&kwartaal=' + kw : '') + (alle ? '&alle=1' : ''); %>
<div class="acties">
  <% if (alle) { %>
    <span>Openstaande posten: <strong>alles t/m <%= nlDatum(tot) %></strong>.</span> <a class="knop klein" href="/rapportages?jaar=<%= jaar %><%= kw ? '&kwartaal=' + kw : '' %>">Alleen <%= periodeTekst %></a>
  <% } else { %>
    <span>Openstaande posten: <strong>facturen uit <%= periodeTekst %></strong>.</span> <a class="knop klein" href="/rapportages?jaar=<%= jaar %><%= kw ? '&kwartaal=' + kw : '' %>&alle=1">Ook eerdere perioden</a>
    <% if (ouderOpen) { %><span class="hulp"><%= ouderOpen %> inkoopfactuur/-facturen van vóór deze periode staan nog open.</span><% } %>
  <% } %>
</div>

<% const openLijst = (id, kop, soort, rijen, relKop) => { %>
<h2 id="<%= id %>"><%= kop %></h2>
<form method="post" action="/rapportages/markeer-betaald" data-bevestig="Geselecteerde facturen markeren als <%= soort === 'inkoop' ? 'betaald' : 'ontvangen' %> (op de vervaldatum, of anders de factuurdatum)?">
  <%- include('partials/csrf') %><input type="hidden" name="soort" value="<%= soort %>"><input type="hidden" name="terug" value="<%= terugUrl %>">
  <div class="tabel-wrap"><table class="klikbaar">
    <thead><tr><th><input type="checkbox" data-alles-selecteren title="Alles selecteren"></th><th>Factuur</th><th><%= relKop %></th><th>Datum</th><th>Vervaldatum</th><th class="bedrag">Open</th></tr></thead>
    <tbody><% if (!rijen.length) { %><tr><td colspan="6" class="zacht">Niets openstaand.</td></tr><% } %>
    <% rijen.forEach(f => { %><tr data-href="/<%= soort %>/<%= f.id %>"><td><input type="checkbox" name="ids[]" value="<%= f.id %>"></td><td><a href="/<%= soort %>/<%= f.id %>"><%= f.factuurnummer || '#' + f.id %></a></td><td><%= f.relatie_naam || '' %></td><td><%= nlDatum(f.factuurdatum) %></td><td class="<%= f.vervaldatum && f.vervaldatum < vandaag ? 'negatief' : '' %>"><%= nlDatum(f.vervaldatum) %></td><td class="bedrag"><%= euro(f.openstaand) %></td></tr><% }) %></tbody>
    <tfoot><tr><td colspan="5">Totaal</td><td class="bedrag"><%= euro(rijen.reduce((s, f) => s + f.openstaand, 0)) %></td></tr></tfoot>
  </table></div>
  <% if (rijen.length) { %><div class="acties"><button class="klein" type="submit">Geselecteerde markeren als <%= soort === 'inkoop' ? 'betaald' : 'ontvangen' %></button>
    <span class="hulp">Voor facturen die al betaald zijn maar (nog) niet aan een banktransactie gekoppeld, bv. van vóór je eerste N26-import of via incasso.</span></div><% } %>
</form>
<% } %>
<% openLijst('debiteuren', 'Nog te ontvangen', 'verkoop', debiteuren, 'Klant') %>
<% openLijst('crediteuren', 'Nog te betalen', 'inkoop', crediteuren, 'Leverancier') %>
<%- include('partials/voet') %>
